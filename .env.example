# ==============================================================================
# INNSPARK Technical Evaluation - Environment Configuration Template
# Login Activity Monitor for Suspicious Behaviour (Backend)
# ==============================================================================
# Configure these environment variables in your operating system shell, IDE run
# configuration, or export them before launching the application.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Connection (MySQL 8)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=login_monitor
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ------------------------------------------------------------------------------
# 3. Email & SMTP Configuration (Security Alerts & OTP Delivery)
# ------------------------------------------------------------------------------
APP_ALERTS_EMAIL_ENABLED=false
APP_ALERTS_EMAIL_TO=admin@example.com
MAIL_FROM=noreply@innspark.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_specific_password_here

# ------------------------------------------------------------------------------
# 4. CAPTCHA Protection Configuration (Backend Google reCAPTCHA v3)
# ------------------------------------------------------------------------------
APP_CAPTCHA_ENABLED=false
APP_CAPTCHA_SECRET=your_recaptcha_v3_secret_key_here
APP_CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
APP_CAPTCHA_SCORE_THRESHOLD=0.5
APP_CAPTCHA_FAILURE_THRESHOLD=3

# ------------------------------------------------------------------------------
# 5. Multi-Factor Authentication (OTP / 2FA) Configuration
# ------------------------------------------------------------------------------
APP_OTP_ENABLED=true
APP_OTP_EXPIRATION_MINUTES=5
APP_OTP_MAX_ATTEMPTS=5
APP_OTP_RESEND_COOLDOWN_SECONDS=60
APP_OTP_MAX_RESENDS=3
